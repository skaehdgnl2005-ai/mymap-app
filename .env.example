# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. `EXPO_PUBLIC_*` vars are inlined into the JS bundle
# at build time and are PUBLIC — never put server-only secrets here.

# Mapbox runtime token (public, restricted to URL/bundle-id at account.mapbox.com)
EXPO_PUBLIC_MAPBOX_TOKEN=

# Naver Open API Local Search (DESIGN.md D5b — v1 POI provider).
# Issue at https://developers.naver.com/apps/#/register with "검색"
# API enabled. Both vars must be set together; missing either makes
# Naver search throw at first call.
EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_NAVER_CLIENT_SECRET=

# Kakao Local API REST key — NOT CURRENTLY USED per D5b.
# Preserved here as the migration target back to D5 when 사업자 등록
# becomes viable (see src/kakao/client.ts archive header for full
# migration steps). Leave blank at v1.
EXPO_PUBLIC_KAKAO_REST_API_KEY=

# Supabase (filled in Phase 3)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox Downloads token (PRIVATE — `Downloads:Read` scope, used by EAS Build
# and `expo prebuild` for the Android Maven repo. Never expose to client bundle.)
MAPBOX_DOWNLOADS_TOKEN=

# Phase 5 dev-only: hardcoded test user for save-flow validation work.
# Onboarding ships in Phase 6; until then the app signs in as this user
# at boot. Create the account once via Supabase dashboard (or `supabase
# auth admin` CLI), then put the credentials here. Both vars must be set
# together; missing either leaves the app unauthenticated and falls back
# to the Phase 4 mock-pin fixture for renderer-only dev work.
EXPO_PUBLIC_TEST_USER_EMAIL=
EXPO_PUBLIC_TEST_USER_PASSWORD=
