{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_comment": "Plain-JSON token file. Compatible with Style Dictionary if you later want platform-specific output (iOS .swift, Android .xml, web .css). Field names follow the locked D8 palette.",

  "color": {
    "light": {
      "_comment": "13 colors for light mode base + brand. Source of truth — both spec/style-light.json and the surrounding RN UI consume these.",
      "surface_base":      { "value": "#F5F4F0", "type": "color", "_": "warm-shifted off-white; map land + UI background" },
      "road_minor":        { "value": "#E8E6E0", "type": "color" },
      "road_major":        { "value": "#DDD9D0", "type": "color" },
      "road_highway":      { "value": "#C9C3B5", "type": "color" },
      "water":             { "value": "#C9D4DD", "type": "color", "_": "cool but soft, complements warm base" },
      "parks_green":       { "value": "#D8DCC8", "type": "color", "_": "muted sage, not saturated" },
      "parks_dark":        { "value": "#6B7561", "type": "color", "_": "italic park label color, derived from parks_green" },
      "building_fill":     { "value": "#EDEBE5", "type": "color" },
      "admin_boundary":    { "value": "#B8B5AC", "type": "color" },
      "text_primary":      { "value": "#1A1A1A", "type": "color", "_": "near-black, never pure black" },
      "text_secondary":    { "value": "#6B6B6B", "type": "color" },
      "text_tertiary":     { "value": "#9A9A95", "type": "color", "_": "AA-large-text only; never body" },
      "brand_indigo":      { "value": "#2D2A6B", "type": "color", "_": "user pins, primary CTAs, hint card. NEVER on labels." },
      "brand_indigo_soft": { "value": "#6B68A8", "type": "color", "_": "anchor pins, hover/disabled" },
      "brand_indigo_dark": { "value": "#1A1850", "type": "color", "_": "halo stroke for die-cut effect" },
      "halo_light":        { "value": "#FFFEFA", "type": "color", "_": "warm-shifted white; reserved for testing only — locked spec uses brand_indigo_dark for halo" }
    },

    "dark": {
      "_comment": "Paired tokens for dark mode. Same identity, different surface.",
      "surface_base":      { "value": "#1B1A18", "type": "color", "_": "deep warm charcoal" },
      "road_minor":        { "value": "#2A2926", "type": "color" },
      "road_major":        { "value": "#3A3833", "type": "color" },
      "road_highway":      { "value": "#4A4740", "type": "color" },
      "water":             { "value": "#2C353C", "type": "color" },
      "parks_green":       { "value": "#2D332A", "type": "color" },
      "parks_dark":        { "value": "#7A8472", "type": "color", "_": "italic park label, lifted for dark surface" },
      "building_fill":     { "value": "#232220", "type": "color" },
      "admin_boundary":    { "value": "#4F4C45", "type": "color" },
      "text_primary":      { "value": "#F0EFEB", "type": "color" },
      "text_secondary":    { "value": "#A8A6A0", "type": "color" },
      "text_tertiary":     { "value": "#6B6964", "type": "color" },
      "brand_indigo":      { "value": "#6B68C8", "type": "color", "_": "lightened for dark-mode contrast (~5.2:1 against surface)" },
      "brand_indigo_soft": { "value": "#8E8BD8", "type": "color" },
      "brand_indigo_dark": { "value": "#1B1A18", "type": "color", "_": "matches surface — die-cut effect on dark" }
    },

    "color_tag": {
      "_comment": "User-selectable pin tags from D6 schema. Render as fill ONLY when user activates color filter; default map renders all pins as brand_indigo regardless of tag.",
      "NONE":   { "value": null, "type": "color", "_": "default — pin renders as brand_indigo" },
      "RED":    { "value": "#E5564B", "type": "color" },
      "ORANGE": { "value": "#F08A4B", "type": "color" },
      "YELLOW": { "value": "#E8B939", "type": "color" },
      "GREEN":  { "value": "#5C8A5C", "type": "color" },
      "BLUE":   { "value": "#4A7CB8", "type": "color" },
      "PURPLE": { "value": "#8B6BB1", "type": "color" }
    },

    "subway_line": {
      "_comment": "Seoul Metro line colors at canonical hue, ~40% saturation per D11. Identity preserved, visual weight reduced so brand_indigo owns hierarchy.",
      "line_1":     { "value": "#7595B5", "type": "color", "_": "deep blue (canonical) desaturated" },
      "line_2":     { "value": "#7BAA88", "type": "color", "_": "green" },
      "line_3":     { "value": "#D6A87A", "type": "color", "_": "orange" },
      "line_4":     { "value": "#7895C9", "type": "color", "_": "sky blue" },
      "line_5":     { "value": "#9E7BB5", "type": "color", "_": "purple" },
      "line_6":     { "value": "#B5896B", "type": "color", "_": "brown" },
      "line_7":     { "value": "#8FA47B", "type": "color", "_": "olive" },
      "line_8":     { "value": "#D67BA4", "type": "color", "_": "pink" },
      "line_9":     { "value": "#C9B27B", "type": "color", "_": "gold" },
      "bundang":    { "value": "#D69E7B", "type": "color" },
      "shinbundang":{ "value": "#C97B7B", "type": "color" },
      "arex":       { "value": "#7B95C9", "type": "color", "_": "airport express; visible at zoom 14+ only, not in hub set" }
    }
  },

  "typography": {
    "_comment": "Pretendard for both UI and map labels. Weights and sizes per D11 typography table.",
    "font_family": {
      "primary": { "value": "Pretendard", "type": "fontFamily" },
      "fallback": { "value": "system-ui, -apple-system, BlinkMacSystemFont, Roboto, sans-serif", "type": "fontFamily" }
    },
    "font_weight": {
      "regular": { "value": 400, "type": "fontWeight" },
      "medium":  { "value": 500, "type": "fontWeight" },
      "bold":    { "value": 700, "type": "fontWeight" }
    },
    "font_size": {
      "label_xs":    { "value": "10px", "type": "fontSize", "_": "동, street, building, subway station" },
      "label_sm":    { "value": "11px", "type": "fontSize", "_": "구, region nick, street major" },
      "label_md":    { "value": "12px", "type": "fontSize", "_": "시/도" },
      "ui_body":     { "value": "14px", "type": "fontSize" },
      "ui_heading":  { "value": "18px", "type": "fontSize" },
      "ui_title":    { "value": "24px", "type": "fontSize" }
    }
  },

  "spacing": {
    "xs":  { "value": "4px",  "type": "dimension" },
    "sm":  { "value": "8px",  "type": "dimension" },
    "md":  { "value": "16px", "type": "dimension" },
    "lg":  { "value": "24px", "type": "dimension" },
    "xl":  { "value": "40px", "type": "dimension" }
  },

  "radius": {
    "sm":  { "value": "4px",  "type": "dimension", "_": "anchor pin corner radius" },
    "md":  { "value": "8px",  "type": "dimension" },
    "lg":  { "value": "16px", "type": "dimension", "_": "card / popover" },
    "full":{ "value": "9999px","type": "dimension","_": "circle / pill" }
  },

  "marker": {
    "_comment": "Pin geometry per D10 lock.",
    "saved_pin_default":      { "value": "18px", "type": "dimension" },
    "saved_pin_selected_w":   { "value": "28px", "type": "dimension" },
    "saved_pin_selected_h":   { "value": "34px", "type": "dimension" },
    "anchor_pin_default":     { "value": "24px", "type": "dimension" },
    "anchor_pin_selected":    { "value": "36px", "type": "dimension" },
    "cluster_low_zoom":       { "value": "18px", "type": "dimension", "_": "zoom 12-13 at 80% opacity" },
    "cluster_default":        { "value": "24px", "type": "dimension", "_": "zoom 14+ (clusters end above)" },
    "halo_default":           { "value": "1.5px", "type": "dimension" },
    "halo_selected":          { "value": "2.0px", "type": "dimension" },
    "icon_saved":             { "value": "10px", "type": "dimension", "_": "category glyph inside saved pin" },
    "icon_anchor":            { "value": "14px", "type": "dimension", "_": "role glyph inside anchor pin" }
  },

  "motion": {
    "_comment": "All shape/state transitions use the same spring per D9 lock.",
    "spring_default": {
      "value": {
        "duration": "200ms",
        "easing": "spring",
        "tension": 300,
        "friction": 24
      },
      "type": "transition"
    },
    "cluster_zoom": {
      "value": {
        "duration": "350ms",
        "easing": "ease-out"
      },
      "type": "transition"
    },
    "search_pulse": {
      "value": {
        "duration": "1200ms",
        "easing": "ease-in-out",
        "iterationCount": "infinite",
        "direction": "alternate"
      },
      "type": "animation"
    }
  }
}
